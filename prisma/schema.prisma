// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillingStatus {
  INACTIVE
  PENDING
  ACTIVE
  CANCELLED
  FROZEN
  DECLINED
  EXPIRED
}

enum ApplyMode {
  CHEAPEST_ELIGIBLE
  MATCHING_TITLE
  ALL_ELIGIBLE
}

enum ShippingTitleMatchType {
  NONE
  CONTAINS
  EXACT
  STARTS_WITH
  REGEX
}

enum ShippingProtectionPricingMode {
  TIERED
  FORMULA
}

model Shop {
  id                   String        @id @default(cuid())
  shopDomain           String        @unique
  accessTokenEncrypted String?
  installedAt          DateTime      @default(now())
  uninstalledAt        DateTime?
  billingStatus        BillingStatus @default(INACTIVE)
  subscriptionId       String?
  planName             String?
  trialEndsAt          DateTime?
  ruleSets             RuleSet[]
  shippingProtection   ShippingProtection?
  eventLogs            EventLog[]
  orderAnalytics       OrderAnalytics[]

  @@index([billingStatus])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model RuleSet {
  id                     String                 @id @default(cuid())
  shopId                 String
  shop                   Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  enabled                Boolean                @default(true)
  name                   String                 @default("No stacking free shipping")
  minSubtotalCents       Int                    @default(40000)
  maxWeightGrams         Int                    @default(13608)
  maxQuantity            Int                    @default(6)
  blockDiscountCodes     Boolean                @default(true)
  blockOrderDiscounts    Boolean                @default(true)
  blockProductDiscounts  Boolean                @default(true)
  blockShippingDiscounts Boolean                @default(true)
  applyMode              ApplyMode              @default(CHEAPEST_ELIGIBLE)
  shippingTitleMatchType ShippingTitleMatchType @default(CONTAINS)
  shippingTitleMatchValue String?
  excludedTitleTerms     Json                   @default("[\"Next Day\", \"Overnight\", \"Express\", \"Air\"]")
  configJson             Json                   @default("{}")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([shopId])
}

model ShippingProtection {
  id                String                        @id @default(cuid())
  shopId            String                        @unique
  shop              Shop                          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  enabled           Boolean                       @default(false)
  pricingMode       ShippingProtectionPricingMode @default(TIERED)
  productTitle      String                        @default("Shipping Protection")
  widgetHeading     String                        @default("Shipping protection")
  widgetDescription String                        @default("Protect your order from loss, damage, or theft.")
  optInLabel        String                        @default("Add shipping protection")
  defaultSelected   Boolean                       @default(false)
  tiersJson         Json                          @default("[{\"minCents\":0,\"maxCents\":1000,\"amountCents\":100},{\"minCents\":1000,\"maxCents\":3000,\"amountCents\":300},{\"minCents\":3000,\"maxCents\":6000,\"amountCents\":500},{\"minCents\":6000,\"maxCents\":null,\"amountCents\":700}]")
  formulaJson       Json                          @default("{\"amountCents\":100,\"everyCents\":1000,\"minChargeCents\":100,\"maxChargeCents\":1500}")
  productId         String?
  variantMapJson    Json                          @default("{}")
  syncError         String?
  syncedAt          DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([shopId])
}

model EventLog {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type         String
  message      String
  metadataJson Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([shopId, createdAt])
}

model OrderAnalytics {
  id                          String   @id @default(cuid())
  shopId                      String
  shop                        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyOrderId              String
  orderName                   String?
  orderCreatedAt              DateTime
  currencyCode                String   @default("USD")
  subtotalCents               Int      @default(0)
  totalCents                  Int      @default(0)
  discountCents               Int      @default(0)
  taxCents                    Int      @default(0)
  shippingPriceCents          Int      @default(0)
  shippingDiscountCents       Int      @default(0)
  paidShippingCents           Int      @default(0)
  freeShippingApplied         Boolean  @default(false)
  shippingProtectionCents     Int      @default(0)
  shippingProtectionPurchased Boolean  @default(false)
  itemQuantity                Int      @default(0)
  uniqueProductCount          Int      @default(0)
  totalWeightGrams            Int      @default(0)
  customerId                  String?
  customerOrderCount          Int?
  sourceName                  String?
  financialStatus             String?
  fulfillmentStatus           String?
  shippingMethod              String?
  shippingCountry             String?
  shippingProvince            String?
  shippingCity                String?
  discountCodesJson           Json     @default("[]")
  lineItemsJson               Json     @default("[]")
  shippingLinesJson           Json     @default("[]")
  paymentGatewayNamesJson     Json     @default("[]")
  tagsJson                    Json     @default("[]")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([shopId, shopifyOrderId])
  @@index([shopId, orderCreatedAt])
  @@index([shopId, freeShippingApplied])
  @@index([shopId, sourceName])
  @@index([shopId, shippingCountry])
}
