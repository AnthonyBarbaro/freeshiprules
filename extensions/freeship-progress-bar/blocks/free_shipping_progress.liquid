{% if block.settings.enabled %}
  <div
    id="freeship-rules-progress-{{ block.id }}"
    class="freeship-rules-progress"
    data-freeship-progress
    data-placement="{{ block.settings.placement }}"
    data-size="{{ block.settings.size }}"
    hidden
  >
    <p class="freeship-rules-progress__heading"></p>
    <div
      class="freeship-rules-progress__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="freeship-rules-progress__fill"></div>
    </div>
    <p class="freeship-rules-progress__message" aria-live="polite"></p>
  </div>
  {{ 'freeship-progress.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'freeship-progress.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Free shipping progress",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show progress bar",
      "default": true
    },
    {
      "type": "select",
      "id": "placement",
      "label": "Default placement",
      "default": "cart-page",
      "options": [
        {
          "value": "cart-page",
          "label": "Small box on cart page"
        },
        {
          "value": "inline",
          "label": "Where Shopify renders the embed"
        }
      ]
    },
    {
      "type": "select",
      "id": "size",
      "label": "Widget size",
      "default": "compact",
      "options": [
        {
          "value": "compact",
          "label": "Small box"
        },
        {
          "value": "standard",
          "label": "Full width"
        }
      ]
    }
  ]
}
{% endschema %}
