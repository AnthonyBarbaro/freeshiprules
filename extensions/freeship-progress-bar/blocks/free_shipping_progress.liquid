{% if block.settings.enabled %}
  <div
    id="freeship-rules-progress-{{ block.id }}"
    class="freeship-rules-progress"
	    data-freeship-progress
	    data-placement="{{ block.settings.placement }}"
	    data-custom-target="{{ block.settings.custom_target_selector | escape }}"
	    data-custom-position="{{ block.settings.custom_target_position }}"
	    data-size="{{ block.settings.size }}"
	    data-show-heading="{{ block.settings.show_heading }}"
	    data-show-icon="{{ block.settings.show_icon }}"
	    style="
	      --fsr-progress-background: {{ block.settings.background_color }};
	      --fsr-progress-text: {{ block.settings.text_color }};
	      --fsr-progress-border: {{ block.settings.border_color }};
	      --fsr-progress-track: {{ block.settings.track_color }};
	      --fsr-progress-fill: {{ block.settings.fill_color }};
	      --fsr-progress-success-fill: {{ block.settings.success_color }};
	      --fsr-progress-radius: {{ block.settings.corner_radius }}px;
	      --fsr-progress-font-size: {{ block.settings.font_size }}px;
	      --fsr-progress-bar-height: {{ block.settings.bar_height }}px;
	      --fsr-progress-compact-width: {{ block.settings.compact_width }}px;
	      --fsr-progress-padding: {{ block.settings.padding }}px;
	      --fsr-progress-border-width: {{ block.settings.border_width }}px;
	      --fsr-progress-shadow-opacity: {{ block.settings.shadow_opacity | divided_by: 100.0 }};
	      --fsr-progress-margin-top: {{ block.settings.margin_top }}px;
	      --fsr-progress-margin-bottom: {{ block.settings.margin_bottom }}px;
	      --fsr-progress-fixed-offset: {{ block.settings.fixed_offset }}px;
	      --fsr-progress-mobile-offset: {{ block.settings.mobile_bottom_offset }}px;
	      --fsr-progress-align: {{ block.settings.text_alignment }};
	    "
	    hidden
	  >
    <p class="freeship-rules-progress__heading"></p>
    <div
      class="freeship-rules-progress__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="freeship-rules-progress__fill"></div>
    </div>
    <p class="freeship-rules-progress__message" aria-live="polite"></p>
  </div>
  {{ 'freeship-progress.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'freeship-progress.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Free shipping progress",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show progress bar",
      "default": true
    },
    {
      "type": "select",
      "id": "placement",
      "label": "Default placement",
      "default": "cart-page",
      "options": [
        {
          "value": "cart-page",
          "label": "Right side above checkout"
        },
        {
          "value": "cart-after-checkout",
          "label": "Right side below checkout"
        },
        {
          "value": "cart-top",
          "label": "Above cart items"
        },
        {
          "value": "fixed-right",
          "label": "Floating right side"
        },
        {
          "value": "fixed-bottom-right",
          "label": "Floating bottom right"
        },
        {
          "value": "inline",
          "label": "Where Shopify renders the embed"
        }
      ]
    },
    {
      "type": "text",
      "id": "custom_target_selector",
      "label": "Custom placement selector",
      "info": "Optional CSS selector, like .cart__blocks or #main-cart-footer."
    },
    {
      "type": "select",
      "id": "custom_target_position",
      "label": "Custom selector position",
      "default": "inside_end",
      "options": [
        {
          "value": "inside_start",
          "label": "Inside at top"
        },
        {
          "value": "inside_end",
          "label": "Inside at bottom"
        },
        {
          "value": "before",
          "label": "Before selector"
        },
        {
          "value": "after",
          "label": "After selector"
        }
      ]
    },
	    {
	      "type": "select",
	      "id": "size",
      "label": "Widget size",
      "default": "compact",
      "options": [
        {
          "value": "compact",
          "label": "Small box"
        },
        {
          "value": "standard",
          "label": "Full width"
	        }
	      ]
	    },
	    {
	      "type": "color",
	      "id": "background_color",
	      "label": "Background",
	      "default": "#f7faf8"
	    },
	    {
	      "type": "color",
	      "id": "text_color",
	      "label": "Text",
	      "default": "#121212"
	    },
	    {
	      "type": "color",
	      "id": "border_color",
	      "label": "Border",
	      "default": "#d9dedb"
	    },
	    {
	      "type": "color",
	      "id": "track_color",
	      "label": "Track",
	      "default": "#d9dedb"
	    },
	    {
	      "type": "color",
	      "id": "fill_color",
	      "label": "Progress",
	      "default": "#008060"
	    },
	    {
	      "type": "color",
	      "id": "success_color",
	      "label": "Qualified progress",
	      "default": "#008060"
	    },
	    {
	      "type": "checkbox",
	      "id": "show_heading",
	      "label": "Show heading",
	      "default": true
	    },
	    {
	      "type": "checkbox",
	      "id": "show_icon",
	      "label": "Show heading dot",
	      "default": true
	    },
	    {
	      "type": "select",
	      "id": "text_alignment",
	      "label": "Text alignment",
	      "default": "left",
	      "options": [
	        {
	          "value": "left",
	          "label": "Left"
	        },
	        {
	          "value": "center",
	          "label": "Center"
	        },
	        {
	          "value": "right",
	          "label": "Right"
	        }
	      ]
	    },
	    {
	      "type": "range",
	      "id": "corner_radius",
	      "label": "Corner radius",
	      "min": 0,
	      "max": 24,
	      "step": 1,
	      "unit": "px",
	      "default": 8
	    },
	    {
	      "type": "range",
	      "id": "font_size",
	      "label": "Font size",
	      "min": 12,
	      "max": 22,
	      "step": 1,
	      "unit": "px",
	      "default": 15
	    },
	    {
	      "type": "range",
	      "id": "bar_height",
	      "label": "Bar height",
	      "min": 4,
	      "max": 24,
	      "step": 1,
	      "unit": "px",
	      "default": 10
	    },
	    {
	      "type": "range",
	      "id": "padding",
	      "label": "Padding",
	      "min": 6,
	      "max": 32,
	      "step": 1,
	      "unit": "px",
	      "default": 13
	    },
	    {
	      "type": "range",
	      "id": "border_width",
	      "label": "Border width",
	      "min": 0,
	      "max": 4,
	      "step": 1,
	      "unit": "px",
	      "default": 1
	    },
	    {
	      "type": "range",
	      "id": "shadow_opacity",
	      "label": "Shadow strength",
	      "min": 0,
	      "max": 30,
	      "step": 1,
	      "unit": "%",
	      "default": 5
	    },
	    {
	      "type": "range",
	      "id": "compact_width",
	      "label": "Compact width",
	      "min": 240,
	      "max": 640,
	      "step": 10,
	      "unit": "px",
	      "default": 380
	    },
	    {
	      "type": "range",
	      "id": "margin_top",
	      "label": "Top spacing",
	      "min": 0,
	      "max": 60,
	      "step": 2,
	      "unit": "px",
	      "default": 12
	    },
	    {
	      "type": "range",
	      "id": "margin_bottom",
	      "label": "Bottom spacing",
	      "min": 0,
	      "max": 60,
	      "step": 2,
	      "unit": "px",
	      "default": 16
	    },
	    {
	      "type": "range",
	      "id": "fixed_offset",
	      "label": "Floating side offset",
	      "min": 8,
	      "max": 80,
	      "step": 2,
	      "unit": "px",
	      "default": 24
	    },
	    {
	      "type": "range",
	      "id": "mobile_bottom_offset",
	      "label": "Mobile bottom offset",
	      "min": 8,
	      "max": 120,
	      "step": 2,
	      "unit": "px",
	      "default": 16
	    }
	  ]
	}
{% endschema %}
